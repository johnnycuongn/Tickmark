{
  "name": "invoice-extract",
  "version": "0.1.0",
  "description": "It won't tick what it can't foot. LLM invoice extraction that cross-checks its own arithmetic and sends only the doubtful fields to a human.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "extract": "tsx src/cli.ts",
    "fixtures": "bash ground-truth/fixtures/build.sh",
    "fixtures:check": "python3 ground-truth/fixtures/check.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "dotenv": "^17.4.2",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
